#!/bin/sh
# A PORTA DO PUSH DO HUB (28/11/2026). O GitHub Pages publica a cada push em `main`: este gancho roda
# ANTES de o push sair e recusa o envio se a conferência acusar algo. Ver scripts/conferir-publicacao.js:
#   - todo ?v= de asset local bate com o md5 do arquivo (senão: node scripts/bump-version.js);
#   - as vozes das séries estão em dia com as atividades (senão: python3 scripts/series-vozes.py).
# Ele confere os arquivos da pasta (o que está no disco), então commite antes de dar push.
#
# Instalação (uma vez por cópia do repositório; as worktrees herdam):
#     git config core.hooksPath .githooks
#
# Emergência (rollback urgente com o conferidor errado):
#     git push --no-verify
ZERO=0000000000000000000000000000000000000000
CONFERIR=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # apagando branch: nada a conferir
  CONFERIR=1
done
[ "$CONFERIR" = 1 ] || exit 0

exec node "$(git rev-parse --show-toplevel)/scripts/conferir-publicacao.js"
